  "sentences": [
    {
      "id": "s001",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina walks into a big, bright classroom."
    },
    {
      "id": "s002",
      "sceneId": "sc01",
      "speaker": "teacher",
      "voiceStyle": "warm",
      "text": "Hi! I'm going to show you your desk.",
      "nativeText": "Hi! I'm gonna show you your desk."
    },
    {
      "id": "s003",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina sits down. Her desk is by the window."
    },
    {
      "id": "s004",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "A boy looks at her and smiles."
    },
    {
      "id": "s005",
      "sceneId": "sc03",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "Hi! I'm Leo. What's your name?"
    },
    {
      "id": "s006",
      "sceneId": "sc03",
      "speaker": "girl",
      "voiceStyle": "calm",
      "text": "Hi! I'm Mina. I'm new here."
    },
    {
      "id": "s007",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina has no pencil. She feels a little shy."
    },
    {
      "id": "s008",
      "sceneId": "sc04",
      "speaker": "girl",
      "voiceStyle": "curious",
      "text": "Can I use your pencil?"
    },
    {
      "id": "s009",
      "sceneId": "sc04",
      "speaker": "boy",
      "voiceStyle": "warm",
      "text": "Sure! Here you go."
    },
    {
      "id": "s010",
      "sceneId": "sc04",
      "speaker": "girl",
      "voiceStyle": "warm",
      "text": "Thank you!"
    },
    {
      "id": "s011",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "The bell rings. It is time to go home."
    },
    {
      "id": "s012",
      "sceneId": "sc05",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "See you tomorrow, Mina!",
      "nativeText": "See ya tomorrow, Mina!"
    },
    {
      "id": "s013",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "Mina smiles. She has a new friend."
    }
  ],
