  "sentences": [
    {
      "id": "s001",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "It is lunch time. Mina is very hungry."
    },
    {
      "id": "s002",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "She takes a tray and stands in line."
    },
    {
      "id": "s003",
      "sceneId": "sc02",
      "speaker": "woman",
      "voiceStyle": "warm",
      "text": "What would you like?"
    },
    {
      "id": "s004",
      "sceneId": "sc02",
      "speaker": "girl",
      "voiceStyle": "calm",
      "text": "Pizza, please."
    },
    {
      "id": "s005",
      "sceneId": "sc02",
      "speaker": "woman",
      "voiceStyle": "warm",
      "text": "Do you want some milk?",
      "nativeText": "Want some milk?"
    },
    {
      "id": "s006",
      "sceneId": "sc02",
      "speaker": "girl",
      "voiceStyle": "excited",
      "text": "Yes, please!"
    },
    {
      "id": "s007",
      "sceneId": "sc03",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina looks for a seat. The tables are full."
    },
    {
      "id": "s008",
      "sceneId": "sc03",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "Mina! Sit with us!"
    },
    {
      "id": "s009",
      "sceneId": "sc04",
      "speaker": "girl",
      "voiceStyle": "curious",
      "text": "Can I sit here?"
    },
    {
      "id": "s010",
      "sceneId": "sc04",
      "speaker": "boy",
      "voiceStyle": "warm",
      "text": "Of course!"
    },
    {
      "id": "s011",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "The pizza is hot and yummy."
    },
    {
      "id": "s012",
      "sceneId": "sc05",
      "speaker": "boy",
      "voiceStyle": "curious",
      "text": "Do you like pizza?"
    },
    {
      "id": "s013",
      "sceneId": "sc05",
      "speaker": "girl",
      "voiceStyle": "excited",
      "text": "I love it! It's my favorite."
    },
    {
      "id": "s014",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "Mina is not hungry now. She is happy."
    }
  ],
