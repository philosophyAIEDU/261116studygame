  "sentences": [
    {
      "id": "s001",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "It is recess. The playground is loud and fun."
    },
    {
      "id": "s002",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "Kids run, jump, and climb."
    },
    {
      "id": "s003",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina stands by the tree. She watches a game."
    },
    {
      "id": "s004",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Leo and Ava are playing tag."
    },
    {
      "id": "s005",
      "sceneId": "sc03",
      "speaker": "girl",
      "voiceStyle": "curious",
      "text": "Can I play with you?"
    },
    {
      "id": "s006",
      "sceneId": "sc03",
      "speaker": "friend",
      "voiceStyle": "excited",
      "text": "Sure! You're it!"
    },
    {
      "id": "s007",
      "sceneId": "sc03",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "Mina runs fast. She tags Leo."
    },
    {
      "id": "s008",
      "sceneId": "sc04",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "You're so fast!"
    },
    {
      "id": "s009",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Then Ava falls down. Her knee hurts."
    },
    {
      "id": "s010",
      "sceneId": "sc04",
      "speaker": "girl",
      "voiceStyle": "curious",
      "text": "Are you okay?"
    },
    {
      "id": "s011",
      "sceneId": "sc04",
      "speaker": "friend",
      "voiceStyle": "warm",
      "text": "I'm okay. Thanks, Mina."
    },
    {
      "id": "s012",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "They sit on the swings and laugh."
    },
    {
      "id": "s013",
      "sceneId": "sc05",
      "speaker": "friend",
      "voiceStyle": "excited",
      "text": "Let's play again tomorrow!"
    },
    {
      "id": "s014",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "Mina cannot wait."
    }
  ],
