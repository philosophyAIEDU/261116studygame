  "sentences": [
    {
      "id": "s001",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "On Friday, the class goes to the library."
    },
    {
      "id": "s002",
      "sceneId": "sc01",
      "speaker": "teacher",
      "voiceStyle": "whisper",
      "text": "Shh. We use quiet voices here."
    },
    {
      "id": "s003",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina finds a big green book on the top shelf."
    },
    {
      "id": "s004",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "She opens it, and a tiny dragon pops out!"
    },
    {
      "id": "s005",
      "sceneId": "sc03",
      "speaker": "creature",
      "voiceStyle": "curious",
      "text": "Hello! I'm looking for my story. Can you help me?",
      "nativeText": "Hello! I'm lookin' for my story. Can ya help me?"
    },
    {
      "id": "s006",
      "sceneId": "sc03",
      "speaker": "girl",
      "voiceStyle": "whisper",
      "text": "I'm not sure. Let's look together."
    },
    {
      "id": "s007",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "They look behind the chairs. They look under the table."
    },
    {
      "id": "s008",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "curious",
      "text": "Then Mina sees a page on the floor."
    },
    {
      "id": "s009",
      "sceneId": "sc04",
      "speaker": "girl",
      "voiceStyle": "excited",
      "text": "Is this yours?"
    },
    {
      "id": "s010",
      "sceneId": "sc05",
      "speaker": "creature",
      "voiceStyle": "excited",
      "text": "Yes! That's my page! You found it!"
    },
    {
      "id": "s011",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "The dragon jumps back into the book."
    },
    {
      "id": "s012",
      "sceneId": "sc06",
      "speaker": "teacher",
      "voiceStyle": "warm",
      "text": "Mina, would you like to borrow that book?"
    },
    {
      "id": "s013",
      "sceneId": "sc06",
      "speaker": "girl",
      "voiceStyle": "warm",
      "text": "Yes, please. It's a very good story."
    },
    {
      "id": "s014",
      "sceneId": "sc06",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "Mina hugs the book. Inside, the dragon is smiling."
    }
  ],
