  "sentences": [
    {
      "id": "s001",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Today is Leo's birthday. He is eight years old."
    },
    {
      "id": "s002",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Mina has a present. It is in a blue box."
    },
    {
      "id": "s003",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "She rings the doorbell. Leo opens the door."
    },
    {
      "id": "s004",
      "sceneId": "sc02",
      "speaker": "girl",
      "voiceStyle": "excited",
      "text": "Happy birthday, Leo! This is for you."
    },
    {
      "id": "s005",
      "sceneId": "sc02",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "Wow, thank you! Come in!"
    },
    {
      "id": "s006",
      "sceneId": "sc03",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "There are balloons everywhere. The cake has eight candles."
    },
    {
      "id": "s007",
      "sceneId": "sc03",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "Everyone sings the birthday song."
    },
    {
      "id": "s008",
      "sceneId": "sc04",
      "speaker": "woman",
      "voiceStyle": "warm",
      "text": "Make a wish, Leo!"
    },
    {
      "id": "s009",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Leo closes his eyes and blows out the candles."
    },
    {
      "id": "s010",
      "sceneId": "sc05",
      "speaker": "woman",
      "voiceStyle": "warm",
      "text": "Would you like some cake, Mina?"
    },
    {
      "id": "s011",
      "sceneId": "sc05",
      "speaker": "girl",
      "voiceStyle": "calm",
      "text": "Yes, please. Just a little."
    },
    {
      "id": "s012",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "Leo opens the blue box. It is a toy rocket!"
    },
    {
      "id": "s013",
      "sceneId": "sc06",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "I love it! How did you know?"
    },
    {
      "id": "s014",
      "sceneId": "sc06",
      "speaker": "girl",
      "voiceStyle": "warm",
      "text": "You told me. You want to go to the moon!",
      "nativeText": "You told me. You wanna go to the moon!"
    },
    {
      "id": "s015",
      "sceneId": "sc06",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "They laugh and fly the rocket around the room."
    }
  ],
