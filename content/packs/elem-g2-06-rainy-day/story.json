  "sentences": [
    {
      "id": "s001",
      "sceneId": "sc01",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "It is raining. Mina and Leo cannot play outside."
    },
    {
      "id": "s002",
      "sceneId": "sc01",
      "speaker": "boy",
      "voiceStyle": "sad",
      "text": "I'm bored. What should we do?"
    },
    {
      "id": "s003",
      "sceneId": "sc02",
      "speaker": "girl",
      "voiceStyle": "excited",
      "text": "I have an idea! Let's be pirates."
    },
    {
      "id": "s004",
      "sceneId": "sc02",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "They put on raincoats and big yellow boots."
    },
    {
      "id": "s005",
      "sceneId": "sc03",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "Outside, the puddles look like a wide blue sea."
    },
    {
      "id": "s006",
      "sceneId": "sc03",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "Look! A ship!"
    },
    {
      "id": "s007",
      "sceneId": "sc03",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "It is only a little leaf, but today it is a pirate ship."
    },
    {
      "id": "s008",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "The leaf sails across the puddle. The wind pushes it fast."
    },
    {
      "id": "s009",
      "sceneId": "sc04",
      "speaker": "girl",
      "voiceStyle": "excited",
      "text": "Don't let it sink!"
    },
    {
      "id": "s010",
      "sceneId": "sc04",
      "speaker": "narrator",
      "voiceStyle": "excited",
      "text": "Splash! Leo jumps in. Water goes everywhere."
    },
    {
      "id": "s011",
      "sceneId": "sc05",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "They are wet from head to toe."
    },
    {
      "id": "s012",
      "sceneId": "sc05",
      "speaker": "boy",
      "voiceStyle": "excited",
      "text": "That was so much fun!"
    },
    {
      "id": "s013",
      "sceneId": "sc06",
      "speaker": "narrator",
      "voiceStyle": "calm",
      "text": "The rain stops. A rainbow comes out."
    },
    {
      "id": "s014",
      "sceneId": "sc06",
      "speaker": "girl",
      "voiceStyle": "warm",
      "text": "Let's do it again next time."
    },
    {
      "id": "s015",
      "sceneId": "sc06",
      "speaker": "narrator",
      "voiceStyle": "warm",
      "text": "Rainy days are not boring anymore."
    }
  ],
